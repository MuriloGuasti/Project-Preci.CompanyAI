# ==========================================================
# PRECI — Variáveis de Ambiente
# Copie este arquivo para ".env" e preencha os valores reais.
# O ".env" nunca deve ser commitado (ver .gitignore).
# ==========================================================

# ----------------------------------------------------------
# APP
# ----------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:8000
API_PORT=8000

# ----------------------------------------------------------
# SUPABASE
# ----------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# NUNCA exponha a service_role key no frontend — uso exclusivo do backend
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

SUPABASE_STORAGE_BUCKET_DOCUMENTS=documents
SUPABASE_STORAGE_BUCKET_AVATARS=avatars

# Variáveis expostas ao frontend (Vite exige o prefixo VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000

# ----------------------------------------------------------
# IA — PROVEDORES (preencha apenas os que for usar)
# ----------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Adicione novas chaves aqui conforme novos provedores forem integrados
# ex: MISTRAL_API_KEY=
# ex: GROQ_API_KEY=

# Modelo de embeddings usado na geração de vetores para o RAG
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small

# ----------------------------------------------------------
# REDIS (fila de background jobs — ARQ)
# ----------------------------------------------------------
REDIS_URL=redis://redis:6379

# ----------------------------------------------------------
# SEGURANÇA
# ----------------------------------------------------------
JWT_SECRET=
COOKIE_SECRET=
CORS_ORIGIN=http://localhost:5173

# ----------------------------------------------------------
# LOGIN PADRÃO — apenas ambiente de desenvolvimento/teste
# NÃO usar em produção
# ----------------------------------------------------------
DEFAULT_ADMIN_EMAIL=admin@preci.local
DEFAULT_ADMIN_PASSWORD=admin
