# =============================================================================
# PRECI FRONTEND — Variáveis de Ambiente (Template)
# Copie este arquivo para "frontend/.env" e preencha com seus dados.
# NUNCA commite o arquivo "frontend/.env" com chaves reais.
# =============================================================================

# URL base da API FastAPI (Backend)
VITE_API_URL=http://localhost:8000

# Conexão com o Supabase (Substitua pelos dados do seu próprio projeto)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui
